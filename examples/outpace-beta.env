# Example operator profile matching the established deployed tuning.
# Load these into the service environment; retain its own paths, bindings and DNS.
OUTPACE_MAX_PIECE_ADVANCE=4
OUTPACE_REQUEST_TIMEOUT_MS=4000
OUTPACE_PREBUFFER_TIMEOUT_MS=45000
OUTPACE_HLS_STARTUP_TIMEOUT_MS=90000
OUTPACE_ACE_COMPAT=1
OUTPACE_ENABLE_PORT_MAPPING=0
OUTPACE_HLS_IDLE_TIMEOUT_MS=60000

# Optional 0.9.0 beta retained-HLS replay. Actual depth is also byte-limited.
OUTPACE_HISTORY_SECONDS=600
OUTPACE_HISTORY_BYTES=134217728
OUTPACE_HISTORY_TOTAL_BYTES=268435456
