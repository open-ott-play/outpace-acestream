{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "jsonata",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "jobs.*[$type(uses) = \"string\" and $contains(uses, /^victron-venus\\/venus-os-ci-toolkit\\/\\.github\\/workflows\\/[^@]+@[a-f0-9]{40}$/) and $type(with.\"toolkit-ref\") = \"string\" and $contains(with.\"toolkit-ref\", /^[a-f0-9]{40}$/)].{\"currentDigest\": with.\"toolkit-ref\"}"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "victron-venus/venus-os-ci-toolkit",
      "packageNameTemplate": "https://github.com/victron-venus/venus-os-ci-toolkit",
      "datasourceTemplate": "git-refs",
      "fileFormat": "yaml"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/hygiene/allowed-identifiers\\.txt$/"
      ],
      "matchStrings": [
        "(?<currentDigest>[a-f0-9]{40}) # renovate: shared-toolkit-ref;"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "victron-venus/venus-os-ci-toolkit",
      "packageNameTemplate": "https://github.com/victron-venus/venus-os-ci-toolkit",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin"
      ],
      "groupName": "cargo dependencies",
      "groupSlug": "cargo"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Review action and reusable-workflow upgrades together, including immutable digest changes.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions and reusable workflows",
      "groupSlug": "ci-workflows",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Runner and action input migrations remain explicit project changes.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "github-runner",
        "uses-with"
      ],
      "enabled": false
    },
    {
      "description": "Update shared workflow runtime and reviewed hash inventory together with callable references.",
      "matchManagers": [
        "custom.jsonata",
        "custom.regex"
      ],
      "groupName": "GitHub Actions and reusable workflows",
      "groupSlug": "ci-workflows",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "automerge": false,
      "matchDepNames": [
        "victron-venus/venus-os-ci-toolkit"
      ]
    },
    {
      "description": "RSA 0.9 and ed25519-dalek 2 key generation require rand_core 0.6. Raise this bound only with a reviewed signing API migration.",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "crates/ace-wire/Cargo.toml"
      ],
      "matchPackageNames": [
        "rand"
      ],
      "allowedVersions": "<0.9.0"
    },
    {
      "description": "RSA 0.9 SHA-1 signing requires the digest 0.10 and AssociatedOid interfaces. Raise this bound only with a reviewed signing API migration.",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "crates/ace-wire/Cargo.toml"
      ],
      "matchPackageNames": [
        "sha1"
      ],
      "allowedVersions": "<0.11.0"
    }
  ],
  "platformAutomerge": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch"
}
